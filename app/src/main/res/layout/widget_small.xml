<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_company" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/w_sub" android:textSize="12sp" android:maxLines="1" android:text="슬기로운 직장생활" />
    <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/w_text" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:text="불러오는 중" />
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/w_sub" android:textSize="12sp" android:maxLines="1" android:text="" />
</LinearLayout>
